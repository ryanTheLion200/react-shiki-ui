root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_size = 4

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.patch]
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
charset = utf-8-bom
indent_size = 4
